n = int(input("Enter the number of rooms: "))

rooms = []

for i in range(n):
    status = input(f"Is Room {i + 1} dirty or clean? ").lower()
    rooms.append(status)

current_room = 0

while "dirty" in rooms:
    if rooms[current_room] == "dirty":
        print(f"Vacuum cleaner is cleaning Room {current_room + 1}...")
        rooms[current_room] = "clean"
    else:
        print(f"Room {current_room + 1} is already clean.")

    if current_room < n - 1:
        print(f"Moving Right: Room {current_room + 1} -> Room {current_room + 2}")
        current_room += 1
    else:
        print(f"Moving Left: Room {current_room + 1} -> Room {current_room}")
        current_room -= 1

print("\nAll rooms are clean!")
print("Vacuum cleaner stopped.")
